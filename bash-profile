# Bash equivalent of PowerShell profile commands

# sudo alias (though 'sudo' already exists natively in bash)
alias sudo='sudo '

# ls replacement with eza
alias ls='eza --color=always --group-directories-first --icons=always'

# cat replacement with bat
alias cat='bat'

# tools function — args filter the reference, they are not extra files
tools() {
    local f="$HOME/.config/fish/tools.txt"
    [ -f "$f" ] || f="$HOME/.config/supershell/tools.txt"
    if [ ! -f "$f" ]; then
        echo "tools.txt not found — run the installer" >&2
        return 1
    fi
    if [ $# -gt 0 ]; then
        bat "$f" | rg -i "$*"
    else
        bat "$f"
    fi
}

# fd function with default options
fd() {
    command fd --hidden --strip-cwd-prefix "$@"
}

# Fuzzy find → open in nvim / cd. Deliberately NOT named `fzf`: shadowing the
# binary forces a bat preview onto every pipeline and onto tools that shell out
# to fzf. Matches fzf_open (fish) and fzf-open (PowerShell).
fzf_open() {
    local result
    result=$(command fzf --preview 'bat --color=always --style=numbers --line-range=:500 {}' "$@")

    if [ -n "$result" ]; then
        if [ -f "$result" ]; then
            nvim "$result"
        elif [ -d "$result" ]; then
            cd "$result" || return 1
        else
            echo "$result"
        fi
    fi
}

